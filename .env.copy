# Prompture Environment Variables
# Copy this file to .env and fill in your API keys.

# ─── Default Provider ────────────────────────────────────────────────────────
# Set AI_PROVIDER to one of: ollama, openai, claude, google, groq, grok,
# openrouter, azure, lmstudio, moonshot, zai, modelscope, cachibot
AI_PROVIDER=ollama

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ─── Claude (Anthropic) ─────────────────────────────────────────────────────
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ─── Ollama (local) ─────────────────────────────────────────────────────────
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ─── LM Studio (local) ──────────────────────────────────────────────────────
LMSTUDIO_ENDPOINT=http://127.0.0.1:1234/v1/chat/completions
LMSTUDIO_MODEL=deepseek/deepseek-r1-0528-qwen3-8b
LMSTUDIO_API_KEY=

# ─── Azure OpenAI (default backend) ─────────────────────────────────────────
AZURE_API_KEY=
AZURE_API_ENDPOINT=
AZURE_DEPLOYMENT_ID=
AZURE_API_VERSION=2025-01-01-preview

# Azure Claude Backend (optional, for claude-* models on Azure)
AZURE_CLAUDE_API_KEY=
AZURE_CLAUDE_ENDPOINT=
AZURE_CLAUDE_API_VERSION=

# Azure Mistral Backend (optional, for mistral-*/mixtral-* models on Azure)
AZURE_MISTRAL_API_KEY=
AZURE_MISTRAL_ENDPOINT=
AZURE_MISTRAL_API_VERSION=

# ─── Google Gemini ───────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key
GOOGLE_MODEL=gemini-2.5-flash

# ─── Groq ────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# ─── OpenRouter ──────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini

# ─── Grok (xAI) ─────────────────────────────────────────────────────────────
GROK_API_KEY=your-grok-api-key
# XAI_API_KEY is also supported for xAI docs compatibility.
XAI_API_KEY=
GROK_MODEL=grok-4-fast-reasoning
GROK_VIDEO_MODEL=grok-imagine-video

# ─── Moonshot AI (Kimi) ─────────────────────────────────────────────────────
MOONSHOT_API_KEY=your-moonshot-api-key
MOONSHOT_MODEL=kimi-k2-0905-preview
MOONSHOT_ENDPOINT=https://api.moonshot.ai/v1

# ─── Z.ai (Zhipu AI) ────────────────────────────────────────────────────────
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_MODEL=glm-4.7
ZHIPU_ENDPOINT=https://api.z.ai/api/paas/v4

# ─── ModelScope (Alibaba Cloud) ─────────────────────────────────────────────
MODELSCOPE_API_KEY=your-modelscope-api-key
MODELSCOPE_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
MODELSCOPE_ENDPOINT=https://api-inference.modelscope.cn/v1

# ─── CachiBot ───────────────────────────────────────────────────────────────
CACHIBOT_API_KEY=

# ─── HuggingFace ─────────────────────────────────────────────────────────────
HF_ENDPOINT=
HF_TOKEN=

# ─── Local HTTP ──────────────────────────────────────────────────────────────
LOCAL_HTTP_ENDPOINT=http://localhost:8000/generate
LOCAL_HTTP_MODEL=local-model

# ─── AirLLM ─────────────────────────────────────────────────────────────────
AIRLLM_MODEL=meta-llama/Llama-2-7b-hf
AIRLLM_COMPRESSION=

# ─── Stability AI (image generation) ────────────────────────────────────────
STABILITY_API_KEY=

# ─── Runway (image / video / audio) ─────────────────────────────────────────
# Either RUNWAY_API_KEY or RUNWAYML_API_SECRET is accepted.
RUNWAY_API_KEY=

# ─── Kling AI (image + video) ───────────────────────────────────────────────
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_ENDPOINT=
KLING_IMAGE_MODEL=kling-v2-1
KLING_VIDEO_MODEL=kling-v2-1

# ─── MiniMax / Hailuo (LLM + video) ─────────────────────────────────────────
# HAILUO_API_KEY is also supported.
MINIMAX_API_KEY=
HAILUO_API_KEY=
MINIMAX_ENDPOINT=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-Text-01
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-2.3

# ─── Fal.ai (image + video aggregator) ──────────────────────────────────────
FAL_API_KEY=
FAL_ENDPOINT=
FAL_IMAGE_MODEL=fal-ai/flux/dev
FAL_VIDEO_MODEL=fal-ai/kling-video/v2.6/pro/image-to-video

# ─── Phase 1: Mistral, DeepSeek, OpenAI-compatible providers ────────────────
# Mistral AI
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-large-latest

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# OpenAI-compatible aggregators — used with the `openai_compatible` driver
# and a profile (e.g. openai_compatible/fireworks/<model>). Only set the
# key(s) for the profile(s) you actually use.
FIREWORKS_API_KEY=
TOGETHER_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
PERPLEXITY_API_KEY=
NVIDIA_API_KEY=
DEEPINFRA_API_KEY=
SILICONFLOW_API_KEY=

# ─── Phase 2: Rerank providers (Cohere, Voyage, Jina) ───────────────────────
COHERE_API_KEY=
VOYAGE_API_KEY=
JINA_API_KEY=

# ─── Phase 3: Cohere LLM + Cohere/Voyage/Jina embedding model defaults ──────
COHERE_MODEL=command-r-plus
COHERE_EMBEDDING_MODEL=embed-v4.0
VOYAGE_EMBEDDING_MODEL=voyage-3.5
JINA_EMBEDDING_MODEL=jina-embeddings-v3

# ─── Phase 4: AWS Bedrock ───────────────────────────────────────────────────
# boto3's standard credential chain is also honoured (IAM role, ~/.aws/credentials).
# Install: pip install prompture[bedrock]
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0
